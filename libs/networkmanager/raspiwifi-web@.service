[Unit]
Description=RaspiWiFi unprivileged web server (%i)
BindsTo=raspiwifi.service
PartOf=raspiwifi.service
After=raspiwifi.service

[Service]
User=raspiwifi-web
Group=raspiwifi-web
ExecStart=/usr/bin/python3 -I -S -B /usr/lib/raspiwifi/networkmanager/launch.py web.py %i
LoadCredential=admin:/etc/raspiwifi/admin-code
LoadCredential=cert:/etc/raspiwifi/portal-cert.pem
LoadCredential=key:/etc/raspiwifi/portal-key.pem
Restart=on-failure
RestartSec=3s
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictAddressFamilies=AF_UNIX AF_INET
UMask=0077
